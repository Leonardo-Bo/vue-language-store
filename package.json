{
  "name": "vue-language-store",
  "version": "1.1.1",
  "description": "Reusable lightweight translation store for Vue 3 applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run --environment jsdom"
  },
  "peerDependencies": {
    "pinia": "^3.0.0 || ^4.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "pinia": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "vue": "^3.0.0"
  }
}
